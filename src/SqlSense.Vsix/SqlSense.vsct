<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <Extern href="stdidcmd.h" />
  <Extern href="vsshlids.h" />

  <Commands package="guidSqlSensePackage">
    <Menus>
      <Menu guid="guidSqlSenseCmdSet" id="SqlSenseMenu" priority="0x0700" type="Menu">
        <Parent guid="guidSHLMainMenu" id="IDG_VS_MM_TOOLSADDINS" />
        <Strings>
          <ButtonText>SqlSense</ButtonText>
        </Strings>
      </Menu>
      <!-- Document tab right-click menu (IDM_VS_CTXT_EZDOCWINTAB). Empty, so hidden, on tabs that aren't connected query windows. -->
      <Menu guid="guidSqlSenseCmdSet" id="SqlSenseTabMenu" priority="0x0100" type="Menu">
        <Parent guid="guidSqlSenseCmdSet" id="SqlSenseTabGroup" />
        <Strings>
          <ButtonText>Connection Color</ButtonText>
        </Strings>
      </Menu>
    </Menus>

    <Groups>
      <Group guid="guidSqlSenseCmdSet" id="SqlSenseMenuGroup" priority="0x0600">
        <Parent guid="guidSqlSenseCmdSet" id="SqlSenseMenu" />
      </Group>
      <Group guid="guidSqlSenseCmdSet" id="SqlSenseResultsMenuGroup" priority="0x0700">
        <Parent guid="guidSqlSenseCmdSet" id="SqlSenseMenu" />
      </Group>
      <!-- Right-click menu of the SSMS results grid (SQLWorkbenchCommands.IDM_SQLWB_SQLRESGRID_CONTEXT). -->
      <Group guid="guidSqlSenseCmdSet" id="SqlSenseGridContextGroup" priority="0x0700">
        <Parent guid="guidSqlEditorGroup" id="IDM_SQLWB_SQLRESGRID_CONTEXT" />
      </Group>
      <Group guid="guidSqlSenseCmdSet" id="SqlSenseTabGroup" priority="0x0050">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_CTXT_EZDOCWINTAB" />
      </Group>
      <Group guid="guidSqlSenseCmdSet" id="SqlSenseTabColorGroup" priority="0x0100">
        <Parent guid="guidSqlSenseCmdSet" id="SqlSenseTabMenu" />
      </Group>
      <Group guid="guidSqlSenseCmdSet" id="SqlSenseTabFileGroup" priority="0x0200">
        <Parent guid="guidSqlSenseCmdSet" id="SqlSenseTabMenu" />
      </Group>
    </Groups>

    <Buttons>
      <Button guid="guidSqlSenseCmdSet" id="cmdidFormatSql" priority="0x0100" type="Button">
        <Parent guid="guidSqlSenseCmdSet" id="SqlSenseMenuGroup" />
        <CommandFlag>DefaultInvisible</CommandFlag>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>Format SQL</ButtonText>
          <CanonicalName>SqlSense.FormatSql</CanonicalName>
        </Strings>
      </Button>
      <Button guid="guidSqlSenseCmdSet" id="cmdidExpandWildcards" priority="0x0101" type="Button">
        <Parent guid="guidSqlSenseCmdSet" id="SqlSenseMenuGroup" />
        <CommandFlag>DefaultInvisible</CommandFlag>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>Expand Wildcard (SELECT *)</ButtonText>
          <CanonicalName>SqlSense.ExpandWildcards</CanonicalName>
        </Strings>
      </Button>
      <Button guid="guidSqlSenseCmdSet" id="cmdidRefreshSuggestions" priority="0x0102" type="Button">
        <Parent guid="guidSqlSenseCmdSet" id="SqlSenseMenuGroup" />
        <Strings>
          <ButtonText>Refresh Suggestions</ButtonText>
          <CanonicalName>SqlSense.RefreshSuggestions</CanonicalName>
        </Strings>
      </Button>
      <Button guid="guidSqlSenseCmdSet" id="cmdidToggleEnabled" priority="0x0103" type="Button">
        <Parent guid="guidSqlSenseCmdSet" id="SqlSenseMenuGroup" />
        <CommandFlag>TextChanges</CommandFlag>
        <Strings>
          <ButtonText>Disable SqlSense</ButtonText>
          <CanonicalName>SqlSense.ToggleEnabled</CanonicalName>
        </Strings>
      </Button>
      <Button guid="guidSqlSenseCmdSet" id="cmdidShowLog" priority="0x0104" type="Button">
        <Parent guid="guidSqlSenseCmdSet" id="SqlSenseMenuGroup" />
        <Strings>
          <ButtonText>Show Log</ButtonText>
          <CanonicalName>SqlSense.ShowLog</CanonicalName>
        </Strings>
      </Button>
      <Button guid="guidSqlSenseCmdSet" id="cmdidImportSqlPromptStyle" priority="0x0105" type="Button">
        <Parent guid="guidSqlSenseCmdSet" id="SqlSenseMenuGroup" />
        <Strings>
          <ButtonText>Import SQL Prompt Style...</ButtonText>
          <CanonicalName>SqlSense.ImportSqlPromptStyle</CanonicalName>
        </Strings>
      </Button>
      <Button guid="guidSqlSenseCmdSet" id="cmdidEditConnectionColors" priority="0x0106" type="Button">
        <Parent guid="guidSqlSenseCmdSet" id="SqlSenseMenuGroup" />
        <Strings>
          <ButtonText>Edit Connection Colors...</ButtonText>
          <CanonicalName>SqlSense.EditConnectionColors</CanonicalName>
        </Strings>
      </Button>
      <Button guid="guidSqlSenseCmdSet" id="cmdidOpenResultsInExcel" priority="0x0100" type="Button">
        <Parent guid="guidSqlSenseCmdSet" id="SqlSenseResultsMenuGroup" />
        <Strings>
          <ButtonText>Open Results in Excel</ButtonText>
          <CanonicalName>SqlSense.OpenResultsInExcel</CanonicalName>
        </Strings>
      </Button>
      <Button guid="guidSqlSenseCmdSet" id="cmdidScriptResultsAsInsert" priority="0x0101" type="Button">
        <Parent guid="guidSqlSenseCmdSet" id="SqlSenseResultsMenuGroup" />
        <Strings>
          <ButtonText>Script Results as INSERT</ButtonText>
          <CanonicalName>SqlSense.ScriptResultsAsInsert</CanonicalName>
        </Strings>
      </Button>
      <Button guid="guidSqlSenseCmdSet" id="cmdidTabDatabaseColor" priority="0x0100" type="Button">
        <Parent guid="guidSqlSenseCmdSet" id="SqlSenseTabColorGroup" />
        <CommandFlag>DefaultInvisible</CommandFlag>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>TextChanges</CommandFlag>
        <Strings>
          <ButtonText>Color for Database...</ButtonText>
          <CanonicalName>SqlSense.TabDatabaseColor</CanonicalName>
        </Strings>
      </Button>
      <Button guid="guidSqlSenseCmdSet" id="cmdidTabServerColor" priority="0x0101" type="Button">
        <Parent guid="guidSqlSenseCmdSet" id="SqlSenseTabColorGroup" />
        <CommandFlag>DefaultInvisible</CommandFlag>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>TextChanges</CommandFlag>
        <Strings>
          <ButtonText>Color for Server...</ButtonText>
          <CanonicalName>SqlSense.TabServerColor</CanonicalName>
        </Strings>
      </Button>
      <Button guid="guidSqlSenseCmdSet" id="cmdidTabClearDatabaseColor" priority="0x0102" type="Button">
        <Parent guid="guidSqlSenseCmdSet" id="SqlSenseTabColorGroup" />
        <CommandFlag>DefaultInvisible</CommandFlag>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>TextChanges</CommandFlag>
        <Strings>
          <ButtonText>Remove Color for Database</ButtonText>
          <CanonicalName>SqlSense.TabClearDatabaseColor</CanonicalName>
        </Strings>
      </Button>
      <Button guid="guidSqlSenseCmdSet" id="cmdidTabClearServerColor" priority="0x0103" type="Button">
        <Parent guid="guidSqlSenseCmdSet" id="SqlSenseTabColorGroup" />
        <CommandFlag>DefaultInvisible</CommandFlag>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>TextChanges</CommandFlag>
        <Strings>
          <ButtonText>Remove Color for Server</ButtonText>
          <CanonicalName>SqlSense.TabClearServerColor</CanonicalName>
        </Strings>
      </Button>
      <Button guid="guidSqlSenseCmdSet" id="cmdidTabEditConnectionColors" priority="0x0100" type="Button">
        <Parent guid="guidSqlSenseCmdSet" id="SqlSenseTabFileGroup" />
        <CommandFlag>DefaultInvisible</CommandFlag>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>TextChanges</CommandFlag>
        <Strings>
          <ButtonText>Edit Connection Colors File...</ButtonText>
          <CanonicalName>SqlSense.TabEditConnectionColors</CanonicalName>
        </Strings>
      </Button>
    </Buttons>
  </Commands>

  <CommandPlacements>
    <!-- Same group under the other SqlEditors GUID, in case the grid menu is defined there; a missing parent is ignored. -->
    <CommandPlacement guid="guidSqlSenseCmdSet" id="SqlSenseGridContextGroup" priority="0x0700">
      <Parent guid="guidSqlEditorCommandSet" id="IDM_SQLWB_SQLRESGRID_CONTEXT2" />
    </CommandPlacement>
    <CommandPlacement guid="guidSqlSenseCmdSet" id="cmdidOpenResultsInExcel" priority="0x0100">
      <Parent guid="guidSqlSenseCmdSet" id="SqlSenseGridContextGroup" />
    </CommandPlacement>
    <CommandPlacement guid="guidSqlSenseCmdSet" id="cmdidScriptResultsAsInsert" priority="0x0101">
      <Parent guid="guidSqlSenseCmdSet" id="SqlSenseGridContextGroup" />
    </CommandPlacement>
  </CommandPlacements>

  <KeyBindings>
    <KeyBinding guid="guidSqlSenseCmdSet" id="cmdidFormatSql" editor="guidVSStd97" key1="K" mod1="Control" key2="Y" mod2="Control" />
    <KeyBinding guid="guidSqlSenseCmdSet" id="cmdidExpandWildcards" editor="guidVSStd97" key1="B" mod1="Control" key2="W" mod2="Control" />
  </KeyBindings>

  <Symbols>
    <GuidSymbol name="guidSqlSensePackage" value="{b6a1f3d2-7c4e-4a5b-9f10-2e8d6c4b3a91}" />
    <GuidSymbol name="guidSqlSenseCmdSet" value="{d9c4e7a1-5b2f-4c3d-8e6a-0f1b2c3d4e5f}">
      <IDSymbol name="SqlSenseMenu" value="0x1010" />
      <IDSymbol name="SqlSenseMenuGroup" value="0x1020" />
      <IDSymbol name="cmdidFormatSql" value="0x0100" />
      <IDSymbol name="cmdidRefreshSuggestions" value="0x0101" />
      <IDSymbol name="cmdidToggleEnabled" value="0x0102" />
      <IDSymbol name="cmdidExpandWildcards" value="0x0103" />
      <IDSymbol name="cmdidShowLog" value="0x0104" />
      <IDSymbol name="cmdidOpenResultsInExcel" value="0x0105" />
      <IDSymbol name="cmdidScriptResultsAsInsert" value="0x0106" />
      <IDSymbol name="cmdidImportSqlPromptStyle" value="0x0107" />
      <IDSymbol name="cmdidEditConnectionColors" value="0x0108" />
      <IDSymbol name="cmdidTabDatabaseColor" value="0x0109" />
      <IDSymbol name="cmdidTabServerColor" value="0x010A" />
      <IDSymbol name="cmdidTabClearDatabaseColor" value="0x010B" />
      <IDSymbol name="cmdidTabClearServerColor" value="0x010C" />
      <IDSymbol name="cmdidTabEditConnectionColors" value="0x010D" />
      <IDSymbol name="SqlSenseTabMenu" value="0x1050" />
      <IDSymbol name="SqlSenseTabGroup" value="0x1060" />
      <IDSymbol name="SqlSenseTabColorGroup" value="0x1070" />
      <IDSymbol name="SqlSenseTabFileGroup" value="0x1080" />
      <IDSymbol name="SqlSenseResultsMenuGroup" value="0x1030" />
      <IDSymbol name="SqlSenseGridContextGroup" value="0x1040" />
    </GuidSymbol>
    <!-- SSMS SqlEditors: SQLWorkbenchCommands.GUID_SQLEditorGroup -->
    <GuidSymbol name="guidSqlEditorGroup" value="{33f13ac3-80bb-4ecb-85bc-225435603a5e}">
      <IDSymbol name="IDM_SQLWB_SQLRESGRID_CONTEXT" value="0x0070" />
    </GuidSymbol>
    <!-- SSMS SqlEditors: SQLWorkbenchCommands.GUID_SQLEditorCommandSet -->
    <GuidSymbol name="guidSqlEditorCommandSet" value="{52692960-56bc-4989-b5d3-94c47a513e8d}">
