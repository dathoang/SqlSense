<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <Extern href="stdidcmd.h" />
  <Extern href="vsshlids.h" />

  <Commands package="guidSqlSensePackage">
    <Menus>
      <Menu guid="guidSqlSenseCmdSet" id="SqlSenseMenu" priority="0x0700" type="Menu">
        <Parent guid="guidSHLMainMenu" id="IDG_VS_MM_TOOLSADDINS" />
        <Strings>
          <ButtonText>SqlSense</ButtonText>
        </Strings>
      </Menu>
      <!-- Document tab right-click menu (IDM_VS_CTXT_EZDOCWINTAB). Empty, so hidden, on tabs that aren't connected query windows. -->
      <Menu guid="guidSqlSenseCmdSet" id="SqlSenseTabMenu" priority="0x0100" type="Menu">
        <Parent guid="guidSqlSenseCmdSet" id="SqlSenseTabGroup" />
        <Strings>
          <ButtonText>Connection Color</ButtonText>
        </Strings>
      </Menu>
      <Menu guid="guidSqlSenseCmdSet" id="SqlSenseTabDbMenu" priority="0x0100" type="Menu">
        <Parent guid="guidSqlSenseCmdSet" id="SqlSenseTabColorGroup" />
        <CommandFlag>DefaultInvisible</CommandFlag>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>TextChanges</CommandFlag>
        <Strings>
          <ButtonText>Db</ButtonText>
        </Strings>
      </Menu>
      <Menu guid="guidSqlSenseCmdSet" id="SqlSenseTabServerMenu" priority="0x0101" type="Menu">
        <Parent guid="guidSqlSenseCmdSet" id="SqlSenseTabColorGroup" />
        <CommandFlag>DefaultInvisible</CommandFlag>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>TextChanges</CommandFlag>
        <Strings>
          <ButtonText>Server</ButtonText>
        </Strings>
      </Menu>
    </Menus>

